# backend/.env 템플릿 — 값을 채워서 backend/.env로 복사한다 (.env는 Git에 올리지 않음)
# 항목 설명: TRD v1.1 §17, CLAUDE.md §10
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/smallworking_dev
TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/smallworking_test
STORAGE_BACKEND=local
UPLOAD_ROOT=./uploads
BLOB_READ_WRITE_TOKEN=
# Vercel Blob store 공개 주소 (예: https://<store>.public.blob.vercel-storage.com) — STORAGE_BACKEND=blob일 때 필요
BLOB_PUBLIC_BASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CRON_SECRET=
COOKIE_SECURE=false
